# Copy to .env and fill in. Nothing secret is ever read from code.
# Generate SECRET_KEY:      python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./meetsync.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/meetsync   (pip install "psycopg[binary]")

# The only origin allowed by CORS, and where OAuth returns the browser.
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/oauth/microsoft/callback

# Optional. Without it, "Find a time" uses the rule-based parser and a templated recommendation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Powers "Add to my calendar" (say "dentist tomorrow 3-4pm"). Chat model with tool calling;
# free models are rate-limited. Without a key a rule-based parser handles simple phrases.
OPENROUTER_API_KEY=
# Comma-separated list; each is tried in turn if the previous errors or is rate-limited.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,liquid/lfm-2.5-2.6b:free
